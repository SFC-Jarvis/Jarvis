# コピーして .env.local を作る: cp .env.example .env.local
# .env.local はコミットされない（.gitignore 済み）

# OpenClaw Gateway（openclaw onboard 後に表示されるトークン）
OPENCLAW_BASE_URL=http://127.0.0.1:18789
OPENCLAW_GATEWAY_TOKEN=

# 1 にすると OpenClaw なしで画面を開発できる（固定の返答を返す）
JARVIS_MOCK=1

# タスク・予定ツール（services/tools）
JARVIS_TOOLS_PORT=8700
# 空なら OS ごとの既定（mac: ~/Library/Application Support/JARVIS ／ WSL・Linux: ~/.local/share/JARVIS）
JARVIS_DATA_DIR=

# 音声（services/voice）
JARVIS_VOICE_PORT=8710
AIVIS_BASE_URL=http://127.0.0.1:10101
OLLAMA_BASE_URL=http://127.0.0.1:11434
